<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculator</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="machine">
  <div class="brand">
    <span class="name">SUMMAND</span>
    <span class="model">MDL. 01</span>
  </div>

  <div class="tape">
    <div class="op-trail" id="trail"></div>
    <div class="readout" id="readout">0</div>
  </div>

  <div class="keys">
    <button class="clear" data-action="clear">C</button>
    <button class="clear" data-action="sign">±</button>
    <button class="clear" data-action="percent">%</button>
    <button class="op" data-action="divide">÷</button>

    <button data-digit="7">7</button>
    <button data-digit="8">8</button>
    <button data-digit="9">9</button>
    <button class="op" data-action="multiply">×</button>

    <button data-digit="4">4</button>
    <button data-digit="5">5</button>
    <button data-digit="6">6</button>
    <button class="op" data-action="subtract">−</button>

    <button data-digit="1">1</button>
    <button data-digit="2">2</button>
    <button data-digit="3">3</button>
    <button class="op" data-action="add">+</button>

    <button class="wide" data-digit="0">0</button>
    <button data-action="decimal">.</button>
    <button class="equals" data-action="equals">=</button>
  </div>
</div>

<script src="script.js"></script>
</body>
</html>
